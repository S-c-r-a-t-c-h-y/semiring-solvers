\colorlet{bgblue}{blue!10}

 \mdfdefinestyle{mythm}{
   linecolor=blue1, 
   linewidth=1pt,
   topline=true,
   bottomline=true,
   rightline=true,
   leftline=true,
   backgroundcolor=white,
   innertopmargin=2pt, 
   innerbottommargin=8pt,
   skipabove=10pt, 
   skipbelow=10pt,
   frametitlefont=\bfseries,
   nobreak=true,
  %  backgroundcolor=bgblue
 }
 
 \newenvironment{theorem}[1][]{%
   \refstepcounter{ptl}%
   \begin{mdframed}[style=mythm, frametitle={\textcolor{blue1}{Theorem\ \theptl\ifstrempty{#1}{}{ (#1)}}}]}%
   {\end{mdframed}}

\makeatletter
 \mdfdefinestyle{myprop}{
   linecolor=blue1, 
   linewidth=0.8pt,
   topline=false,
   bottomline=true,
   rightline=false,
   leftline=true,
   backgroundcolor=white,
   innertopmargin=2pt, 
   innerbottommargin=8pt,
   skipbelow=10pt,
