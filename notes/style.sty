\newcommand{\workingpoint}{%
  % Works both in text and math modes: in math mode use an \mbox; otherwise keep original paragraph styling
  \ifmmode
    \mbox{{\color{red}\rule{\linewidth}{1.2pt}}\,\textbf{\textcolor{red}{working point}}}%
  \else
    \par\noindent
    {\color{red}\rule{\linewidth}{1.2pt}}\par
    \noindent\textbf{\textcolor{red}{working point}}\par
  \fi
  \medskip
}

\newenvironment{digression}[1][]
  {
    \par\noindent
    {\color{blue1}\rule{\linewidth}{1.2pt}}\par
    \noindent\textbf{\textcolor{blue1}{digression\ifstrempty{#1}{}{ (#1)}}}\par
  }
  {
    \par\noindent
    {\noindent\textbf{\textcolor{blue1}{end of digression}}\par
    \color{blue1}\rule{\linewidth}{1.2pt}}\par
  }

