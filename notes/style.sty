 \makeatletter
 \mdfdefinestyle{myprop}{
   linecolor=blue1, 
   linewidth=0.8pt,
   topline=false,
   bottomline=true,
   rightline=false,
   leftline=true,
   backgroundcolor=white,
   innertopmargin=2pt, 
   innerbottommargin=8pt,
   skipbelow=10pt,
   skipabove=10pt, 
   frametitlefont=\bfseries,
   nobreak=true,
   shadow=true,
   apptotikzsetting={%
   \tikzset{mdfshadow/.style={%
 		general shadow={%
    	shadow xshift=-2pt,
    	shadow yshift=-2pt,
    	fill=bgblue,
    	every shadow }}}}
 }
 \makeatother

 \newenvironment{proposition}[1][]{%
   \refstepcounter{ptl}%
   \begin{mdframed}[style=myprop, frametitle={\textcolor{blue1}{Proposition\ \theptl\ifstrempty{#1}{}{ (#1)}}}]}%
   {\end{mdframed}}
   
   \newenvironment{lemma}[1][]{%
      \refstepcounter{ptl}%
      \begin{mdframed}[style=myprop, frametitle={\textcolor{blue1}{Lemma\ \theptl\ifstrempty{#1}{}{ (#1)}}}]}%
      {\end{mdframed}}
 
